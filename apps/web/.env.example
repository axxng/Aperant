# Turso Database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Authentication
JWT_SECRET=
ADMIN_EMAIL=admin@example.com

# OTP Email (Resend)
# RESEND_API_KEY=re_your_key_here
# OTP_FROM_EMAIL=otp@yourdomain.com

# GitHub Integration (for issue sync)
GITHUB_TOKEN=ghp_your_token_here

# Vercel Cron (auto-set by Vercel in production)
# CRON_SECRET=

# Local Dev Mock Mode (Phase 04.2)
# Set MOCK_SERVICES=true in .env.local to use local SQLite (file:dev.db) instead of Turso.
# Run: cd apps/web && npx tsx scripts/seed.ts  to populate dev.db with fake data.
# JWT_SECRET must be set when using mock mode so tokens persist across dev-server restarts.
# NEVER set MOCK_SERVICES=true in production (Vercel) — it bypasses GitHub OAuth.
MOCK_SERVICES=
VITE_MOCK_SERVICES=
