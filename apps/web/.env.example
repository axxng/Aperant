# Server
PORT=3001
NODE_ENV=development

# Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, a random secret is generated on each server start (tokens won't survive restarts)
JWT_SECRET=

# Admin bootstrap — creates the first admin user on startup when no users exist
ADMIN_EMAIL=admin@example.com

# OTP Email (Resend) — falls back to console.log if not set
# RESEND_API_KEY=re_your_key_here
# OTP_FROM_EMAIL=otp@yourdomain.com

# CORS — comma-separated list of allowed origins (defaults to localhost)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# GitHub Integration (for issue sync)
GITHUB_TOKEN=ghp_your_token_here

# Database path (defaults to ./data/aperant.db)
# DB_PATH=./data/aperant.db
